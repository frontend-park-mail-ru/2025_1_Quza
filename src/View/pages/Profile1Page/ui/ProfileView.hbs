<div id="profile_page">
    <div class="profile-container">
        <img id="user_logo" src="img/main_icon.png">
        <form id="profile-form">
        <div id="profile-input-container1">
                <input type="text" id="bank" placeholder="Введите банковскую карточку">
            </div>
            <div id="profile-input-container2">
                <input type="password" id="profile-password1" placeholder="Введите пароль">
                <img src="img/main_icon.png" alt="" class="profile-show-password">
                <div id="profile-errors-container1"></div>
            </div>
            <div id="profile-input-container3">
                <input type="password" id="profile-password2" placeholder="Введите пароль">
                <img src="img/main_icon.png" alt="" class="profile-show-password1">
                <div id="profile-errors-container2"></div>
            </div>
            <button class="submit-btn" id="redactor">Подтвердить изменения</button>
            </form>
    <input id="file-input" type="file" style="display: none;" accept="image/*">
<label class="edit-ava" for="file-input">
    <img src="img/main_icon.png" alt="" style="width: 50px;height: 50px">
</label>
    </div>
</div>
